# --- חיבור למסד הנתונים (Postgres של Supabase) ---
# פורמט async: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/marketplace

# --- Supabase Storage (להעלאת תמונות פרופיל) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
AVATAR_BUCKET=avatars
MAX_AVATAR_BYTES=5242880

# --- CORS — דומיינים מורשים לפרונט (פסיק מפריד, או * לכל המקורות) ---
ALLOWED_ORIGINS=*

# --- מיתוג הודעת הפתיחה בוואטסאפ ---
WA_GREETING=היי! הגעתי דרך מרקטפלייס המפתחים.

# --- טסטי אינטגרציה (אופציונלי) — Postgres נפרד לטסטים. אם ריק, טסטי ה-API מדולגים ---
TEST_DATABASE_URL=
